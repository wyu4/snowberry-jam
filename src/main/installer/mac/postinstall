#!/usr/bin/env sh
# Overrides jpackage's default PKG postinstall script. jpackage does not substitute its
# INSTALL_LOCATION/APP_LOCATION tokens in an overridden script, so the paths come from the
# Installer instead: $2 is the install location (/Applications).

APP_BUNDLE="$2/${package.appName}.app"

chown root:wheel "$APP_BUNDLE"
chmod a+rX "$APP_BUNDLE"
chmod +r "$APP_BUNDLE/Contents/app/"*.jar

# `snowb` terminal client: link the bundle's launcher onto the PATH, mirroring the
# Windows installer adding the install dir to PATH.
# The link must point at a canonical path: the launcher mis-resolves a target containing "..".
mkdir -p /usr/local/bin
ln -sf "$(cd "$APP_BUNDLE/Contents/MacOS" && pwd -P)/snowb" /usr/local/bin/snowb

exit 0
